{
  "name": "nexpanel-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:check": "npm run build && npm run size",
    "size": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && go build -o ../bin/ ../cmd/npd && playwright test"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.23",
    "@iconify-json/simple-icons": "^1.2.43",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "unplugin-icons": "^22.4.2",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.4"
  }
}
